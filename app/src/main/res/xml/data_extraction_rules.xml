<?xml version="1.0" encoding="utf-8"?><!--
   Update downloads and their identity are installation-local. They must never
   enter a shop backup or device transfer because they are tied to this install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app-updates/" />
        <exclude domain="sharedpref" path="bikepart_update_reminders.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app-updates/" />
        <exclude domain="sharedpref" path="bikepart_update_reminders.xml" />
    </device-transfer>
</data-extraction-rules>
